# Copy this file to .env.local and fill in what you have. All secrets below
# are optional for development: leave any one empty and the app falls back
# to a mock or in-memory stand-in instead. Run "npm run check" any time to
# verify whichever secrets you did set against the real OpenRouter and
# Firebase services, without touching the ones you left empty.

# OpenRouter key (create one at https://openrouter.ai/keys). Optional: empty
# means the app uses mock AI answers instead of calling OpenRouter.
OPENROUTER_API_KEY=

# Optional. A specific OpenRouter model id, which replaces the default chain
# entirely. Empty means the app tries the free google/gemma-4-31b-it:free
# first and, when that answers 429 or a quota/credits error, automatically
# retries the call once with the paid google/gemma-4-31b-it.
OPENROUTER_MODEL=

# Firebase Admin service account JSON for your project, pasted on one line
# and wrapped in single quotes, for example:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'
# Server-only secret: used to verify Firebase ID tokens, assign roles, and
# talk to the Realtime Database. Never expose it to the Vite frontend.
# Optional for development: while this or FIREBASE_DATABASE_URL below is
# empty the app uses an in-memory store that resets on every restart, and
# sign-in verification answers 503 until this is set. Also read by
# scripts/promote-role.mjs.
FIREBASE_SERVICE_ACCOUNT_JSON=

# The Realtime Database URL for the same Firebase project, for example
# https://your-project-default-rtdb.firebaseio.com/. Optional: required
# together with the service account for real storage and working auth
# endpoints; empty (or either setting missing) means the app keeps
# everything in memory.
FIREBASE_DATABASE_URL=

# Max AI calls per profile per UTC day.
DAILY_AI_CALL_CAP=60

# Optional. Max requests per IP per sliding sixty-second window. The robot
# e2e suite raises this to 1000 for the server it starts. Leave it commented
# out to keep the default of 60.
# IP_REQUESTS_PER_MINUTE=60

# Firebase web app configuration. These public identifiers are exposed to the
# browser by Next.js and required for the production sign-in screen.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
