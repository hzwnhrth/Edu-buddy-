# Copy this file to .env.local and fill in what you have. Both secrets
# below are optional for development: leave either one empty and the app
# falls back to a mock instead. Run "npm run check" any time to verify
# whichever secrets you did set against the real Gemini and Firestore
# services, without touching the ones you left empty.

# Google AI Studio key. Empty means the app uses mock AI answers instead of
# calling Gemini.
GEMINI_API_KEY=

# Optional. A specific Gemini model id, for example gemini-2.5-flash. Empty
# means the app lists the models this key can use and picks the newest
# Flash model itself.
GEMINI_MODEL=

# The Firebase service account JSON for your project, pasted on one line
# and wrapped in single quotes, for example:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'
# Empty means the app uses an in-memory store that resets on every restart.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Max AI calls per profile per UTC day.
DAILY_AI_CALL_CAP=60
