# Copy this file to .env.local and fill in what you have. Both secrets
# below are optional for development: leave either one empty and the app
# falls back to a mock instead. Run "npm run check" any time to verify
# whichever secrets you did set against the real OpenRouter and Firebase
# services, without touching the ones you left empty.

# OpenRouter key (create one at https://openrouter.ai/keys). Empty means the
# app uses mock AI answers instead of calling OpenRouter.
OPENROUTER_API_KEY=

# Optional. A specific OpenRouter model id, which replaces the default chain
# entirely. Empty means the app tries the free google/gemma-4-31b-it:free
# first and, when that answers 429 or a quota/credits error, automatically
# retries the call once with the paid google/gemma-4-31b-it.
OPENROUTER_MODEL=

# The Firebase service account JSON for your project, pasted on one line
# and wrapped in single quotes, for example:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'
# Real (browser-independent) storage needs this together with
# FIREBASE_DATABASE_URL below; with either one empty the app uses an
# in-memory store that resets on every restart.
FIREBASE_SERVICE_ACCOUNT_JSON=

# The Realtime Database URL for the same Firebase project, for example
# https://your-project-default-rtdb.firebaseio.com/. Required together with
# the service account for real storage; empty (or either setting missing)
# means the app keeps everything in memory.
FIREBASE_DATABASE_URL=

# Max AI calls per profile per UTC day.
DAILY_AI_CALL_CAP=60

# Optional. Max requests per IP per sliding sixty-second window. The robot
# e2e suite raises this to 1000 for the server it starts. Leave it commented
# out to keep the default of 60.
# IP_REQUESTS_PER_MINUTE=60
